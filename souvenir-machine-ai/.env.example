# Both required. Server-side only — read by api/*.js and dev-api-server.js.
# Never exposed to the browser. Never commit real values here.

# Get a token at https://huggingface.co/settings/tokens (a free "Read"
# token is enough for the Inference API).
HF_TOKEN=

# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
